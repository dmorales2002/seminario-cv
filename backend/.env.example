DATABASE_URL=postgresql://postgres:password@localhost:5433/mvp_db
# Obligatoria: al menos 32 caracteres aleatorios (por ejemplo, python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
# Código para registrar cuentas de reclutador. Si se deja vacío, solo se registran candidatos.
RECRUITER_INVITE_CODE=
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_CV_SIZE_MB=5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
LLM_MAX_DOCUMENT_CHARS=60000
# Tiempo máximo por solicitud de análisis; el cliente repite la solicitud hasta terminar.
ANALYSIS_TIME_BUDGET_SECONDS=40
